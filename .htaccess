# Apache configuration for CareQueue on InfinityFree / Shared Hosting
DirectoryIndex index.php index.html

# Prevent directory browsing
Options -Indexes

# Protect sensitive database, configuration, and environment files
<FilesMatch "(\.sqlite|\.sqlite-journal|\.sqlite-wal|\.log|\.env|\.git|db_config\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Character encoding
AddDefaultCharset UTF-8
